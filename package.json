{
  "name": "agf-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "scan:route-classifications": "node scripts/system-checks.mjs route-classifications",
    "scan:static": "node scripts/system-checks.mjs static",
    "scan:target-bridge": "node scripts/system-checks.mjs target-bridge",
    "scan:page-content": "node scripts/system-checks.mjs page-content",
    "scan:content-admin-snapshots": "node scripts/content-admin-snapshot-audit.mjs",
    "scan:content-admin-snapshots:backups": "node scripts/content-admin-snapshot-audit.mjs --include-backups",
    "repair:content-admin-snapshots": "node scripts/repair-content-admin-snapshot-hygiene.mjs",
    "scan:content-admin-storage": "node scripts/validate-content-admin-storage-roundtrip.mjs",
    "content-admin:publish-seed-routes": "node scripts/publish-content-admin-seed-routes.mjs",
    "scan:snapshot-schema": "node scripts/system-checks.mjs snapshot-schema",
    "scan:readability": "node scripts/system-checks.mjs readability",
    "scan:safety-nets": "node scripts/system-checks.mjs safety-nets",
    "scan:legacy-adapters": "node scripts/system-checks.mjs legacy-adapters",
    "scan:migration-inventory": "node scripts/content-admin-migration-inventory.mjs",
    "scan:legacy-ghosts:403b": "node scripts/legacy-ghost-audit.mjs retirement-403b-rmha",
    "scan:legacy-ghosts:403b:backups": "node scripts/legacy-ghost-audit.mjs retirement-403b-rmha --include-backups",
    "scan:system": "node scripts/system-checks.mjs all",
    "test:system-guardrails": "vitest run src/data/contentAdminSourceConvergence.guardrail.test.js src/lib/contentAdminSnapshotSchema.guardrail.test.js src/lib/systemReadinessInventory.test.js src/lib/managedPageShells.test.js src/context/ContentAdminContext.block-only-shells.guardrail.test.js src/context/ContentAdminContext.state-normalization.test.js src/context/ContentAdminContext.operator-smoke.test.jsx src/styles/serviceNativeStyleOwnership.guardrail.test.js src/lib/adminBlockInsertChoices.test.js src/lib/linkModelConvergenceGuardrail.test.js src/components/migratedBlockEditorOwnership.test.jsx src/components/editorParityCoverage.test.jsx src/blocks/registry/blockRegistry.test.js",
    "check:system": "npm run lint && npm run scan:system && npm run scan:content-admin-snapshots && npm run scan:content-admin-storage && npm run test:system-guardrails && npm test && npm run build",
    "search:index": "node scripts/build-search-index.cjs",
    "test": "vitest run && node --test src/utils/ratesPdfImportCore.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "preview:prod": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "openai": "^6.34.0",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
